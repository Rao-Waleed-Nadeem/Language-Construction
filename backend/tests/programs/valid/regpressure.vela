// regpressure.vela - forces register spilling (> 8 simultaneously live values)
func main() {
    let a: int = 1;
    let b: int = 2;
    let c: int = 3;
    let d: int = 4;
    let e: int = 5;
    let f: int = 6;
    let g: int = 7;
    let h: int = 8;
    let i: int = 9;
    let j: int = 10;
    let total: int = a + b + c + d + e + f + g + h + i + j;
    show total;
}
