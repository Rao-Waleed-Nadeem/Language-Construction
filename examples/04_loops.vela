// 04_loops.vela - for, while, do-while, break, continue, ++ and compound assignment
func main() {
    let sum: int = 0;
    for (let i: int = 1; i <= 5; i++) {
        sum += i;
    }
    show "sum 1..5 = ", sum;

    let n: int = 10;
    let steps: int = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps++;
    }
    show "collatz steps = ", steps;

    let k: int = 0;
    do {
        k += 3;
        if (k == 6) {
            continue;
        }
        show "k=", k;
    } while (k < 10);

    for (let j: int = 0; j < 100; j++) {
        if (j * j > 50) {
            show "first j with j*j>50: ", j;
            break;
        }
    }
}
