// 05_functions.vela - parameters, return, recursion, void function, call before declaration
func fact(n: int): int {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

func fib(n: int): int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func power(base: float, exp: int): float {
    let result: float = 1.0;
    for (let i: int = 0; i < exp; i++) {
        result *= base;
    }
    return result;
}

func banner(title: string) {
    show "== ", title, " ==";
}

func main() {
    banner("functions");
    show "5! = ", fact(5);
    show "fib(10) = ", fib(10);
    show "2.5^3 = ", power(2.5, 3);
    show is_even(10), " ", is_even(7);
}

func is_even(n: int): bool {
    if (n == 0) {
        return true;
    }
    return is_odd(n - 1);
}

func is_odd(n: int): bool {
    if (n == 0) {
        return false;
    }
    return is_even(n - 1);
}
